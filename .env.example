PORT=3000
APP_ENV=production
PUBLIC_SITE_URL=https://elv.art

# Runtime database. This file is ignored by Git so deployments do not overwrite live data.
DB_FILE=data/db.production.json

# Turn this on while uploading products and solutions before launch.
MAINTENANCE_MODE=true
MAINTENANCE_PASSWORD=change-this-maintenance-password

# Admin panel password.
ADMIN_TOKEN=change-this-admin-password

# Email verification and password reset.
SMTP_HOST=mail.privateemail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@elv.art
SMTP_PASS=your-private-email-password
MAIL_FROM=ELV.art <info@elv.art>
